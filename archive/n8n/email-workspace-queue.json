      "id": "80ccad76-743d-492a-9217-0e87873d046d",
      "name": "Buscar clientes EN_COLA",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-560, 60],
      "notesInFlow": true,
      "notes": "Seleccionar la credencial Google Sheets de la clienta. Lee solamente filas con estado EN_COLA."
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .filter(item => String(item.json.estado || '').trim().toUpperCase() === 'EN_COLA')\n  .sort((a, b) => Number(a.json.row_number || 0) - Number(b.json.row_number || 0));\n\nif (rows.length === 0) return [];\n\nconst client = rows[0].json;\nif (!client.id) throw new Error('La fila seleccionada no tiene id.');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(client.email || '').trim())) {\n  throw new Error(`Email invalido para el cliente ${client.id}.`);\n}\nif (!client.tipo_mensaje) throw new Error(`El cliente ${client.id} no tiene tipo_mensaje.`);\n\nreturn [{ json: client }];"
      },
      "id": "4df153ba-c512-42cd-ae67-d1bd07264ac2",
      "name": "Seleccionar un cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 60],
      "notesInFlow": true,
      "notes": "Aunque Sheets devolviera varias filas, este nodo deja pasar solamente una."
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Configuracion').first().json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Configuracion').first().json.plantillasSheet }}",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "codigo",
              "lookupValue": "={{ $('Seleccionar un cliente').first().json.tipo_mensaje }}"
            },
            {
              "lookupColumn": "activo",
              "lookupValue": "SI"
            }
          ]
        },
        "options": {}
      },
      "id": "cbf15104-28e9-4f86-9bd7-ddc439123dea",
      "name": "Buscar plantilla activa",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-80, 60],
      "alwaysOutputData": true,
      "notesInFlow": true,
      "notes": "Usar la misma credencial de Google Sheets. Busca la plantilla cuyo codigo coincide con tipo_mensaje."
    },
    {
      "parameters": {
        "jsCode": "const client = $('Seleccionar un cliente').first().json;\nconst template = $input.first().json;\n\nif (!template.codigo || !template.asunto || !template.mensaje) {\n  throw new Error(`No existe una plantilla activa y completa para ${client.tipo_mensaje}.`);\n}\n\nfunction render(text, data) {\n  return String(text || '').replace(/{{\\s*([a-zA-Z0-9_áéíóúÁÉÍÓÚñÑ-]+)\\s*}}/g, (_, key) => {\n    const field = Object.keys(data).find(k => k.toLowerCase() === key.toLowerCase());\n    return field ? String(data[field] ?? '') : '';\n  });\n}\n\nreturn [{\n  json: {\n    ...client,\n    email: String(client.email).trim(),\n    asunto_renderizado: render(template.asunto, client),\n    mensaje_renderizado: render(template.mensaje, client),\n    siguiente_intento: Number(client.intentos || 0) + 1\n  }\n}];"
      },
      "id": "c455e6b5-babe-4cc9-ad1d-49dfc325ed37",
      "name": "Preparar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 60]
    },
